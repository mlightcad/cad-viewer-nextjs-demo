# Public @mlightcad/* packages come from npmjs.
# Do NOT set @mlightcad:registry to GitHub Packages — that would break public packages.
# Private @mlightcad/dwg-converter is an optionalDependency (GitHub Packages tarball).
# Without GITHUB_TOKEN / package access, pnpm skips it and convert falls back to LibreDWG.
registry=https://registry.npmjs.org/
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
